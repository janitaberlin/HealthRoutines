---
/** Janitas drei Säulen (31.10.2026): High Energy, Feminine Power, Entrepreneur – „The Woman I Am“. Zusammen ergeben sie „That's Me“, ihre höchste Präsenz; daraus folgt alles Weitere. */
const pillars = [
  { x: 58, label: ['High', 'Energy'], words: ['Lebendig.', 'Vital.', 'Voller', 'Lebensfreude.'] },
  { x: 170, label: ['Feminine', 'Power'], words: ['Weiblichkeit.', 'Stärke.', 'Präsenz.'] },
  { x: 282, label: ['Entrepreneur'], words: ['Visionär.', 'Selbstbestimmt.', 'Unternehmerisch.', 'Selbstverwirk-', 'lichung.'] },
];
const results = [
  { x: 60, label: ['Ja oder Nein:', 'sofort klar'] },
  { x: 170, label: ['Ich komme', 'ins Machen'] },
  { x: 280, label: ['Alles fühlt', 'sich leicht an'] },
];
---
<figure class="pillars">
  <svg viewBox="0 0 340 394" role="img" aria-label="The Woman I Am: High Energy (lebendig, vital, voller Lebensfreude), Feminine Power (Weiblichkeit, Stärke, Präsenz) und Entrepreneur (visionär, selbstbestimmt, unternehmerisch, Selbstverwirklichung) ergeben zusammen That's Me. Daraus folgt: Ja oder Nein ist sofort klar, ich komme ins Machen, alles fühlt sich leicht an.">
    <defs>
      <linearGradient id="pillar-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f0d27a" />
        <stop offset="1" stop-color="#d4a437" />
      </linearGradient>
    </defs>
    {results.map((r) => (
      <g>
        <line class="pillars-line" x1="170" y1="146" x2={r.x} y2="62" />
        <text class="pillars-result" x={r.x} y="34" text-anchor="middle"><tspan x={r.x}>{r.label[0]}</tspan><tspan x={r.x} dy="15">{r.label[1]}</tspan></text>
      </g>
    ))}
    {pillars.map((p) => <line class="pillars-line" x1={p.x} y1="236" x2={p.x + (170 - p.x) * 0.26} y2="222" />)}
    <circle cx="170" cy="164" r="30" fill="url(#pillar-gold)" />
    <text class="pillars-star" x="170" y="171" text-anchor="middle">✦</text>
    <text class="pillars-center" x="170" y="212" text-anchor="middle">That's Me</text>
    {pillars.map((p) => (
      <g>
        <rect class="pillars-pillar" x={p.x - 53} y="238" width="106" height="128" rx="14" />
        <text class="pillars-label" x={p.x} y={p.label.length > 1 ? 259 : 267} text-anchor="middle" style={p.label[0].length > 9 ? 'font-size: 10.5px; letter-spacing: 0.01em' : undefined}>
          {p.label.map((l, i) => <tspan x={p.x} dy={i ? 16 : 0}>{l}</tspan>)}
        </text>
        <text class="pillars-words" x={p.x} y="298" text-anchor="middle">
          {p.words.map((w, i) => <tspan x={p.x} dy={i ? 13.5 : 0}>{w}</tspan>)}
        </text>
      </g>
    ))}
    <text class="pillars-base" x="170" y="386" text-anchor="middle">The Woman I Am</text>
  </svg>
</figure>
