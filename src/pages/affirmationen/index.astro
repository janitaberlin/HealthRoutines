---
import Base from '../../layouts/Base.astro';
import { affirmQuestions, defaultAffirmations, languages, science } from '../../data/affirmations';
---
<Base title="My Affirmations" page="affirmationen">
  <section class="affirm-hero">
    <svg class="affirm-orb" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <radialGradient id="orb-core" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#fff7dc" stop-opacity="0.95" />
          <stop offset="0.25" stop-color="#f0d27a" stop-opacity="0.6" />
          <stop offset="0.6" stop-color="#d4a437" stop-opacity="0.15" />
          <stop offset="1" stop-color="#d4a437" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="100" cy="100" r="90" fill="url(#orb-core)" />
      <g class="orb-dust">
        {Array.from({ length: 70 }, (_, i) => {
          const a = i * 2.39996;
          const r = 12 + ((i * 37) % 70);
          return <circle cx={100 + Math.cos(a) * r} cy={100 + Math.sin(a) * r * 0.8} r={0.5 + ((i * 7) % 10) / 10} style={`animation-delay: -${(i * 0.37) % 6}s`} />;
        })}
      </g>
    </svg>
    <p class="eyebrow">Your Practice</p>
    <p class="affirm-day">Day <span id="affirm-days">01</span></p>
  </section>

  <section class="affirm-panel">
    <div class="affirm-tabs" role="tablist">
      <button type="button" role="tab" data-mode="morning" aria-selected="true">Morning</button>
      <button type="button" role="tab" data-mode="power" aria-selected="false">Power</button>
      <button type="button" role="tab" data-mode="evening" aria-selected="false">Evening</button>
    </div>
    <h2 class="affirm-title" id="affirm-title">Your morning words</h2>
    <p class="affirm-sub muted" id="affirm-sub">Set the frame for your day.</p>
    <a class="money-goal" id="money-goal-box" href="../ziele/" hidden>Money-Ziel diese Woche: <strong id="money-goal-show"></strong> ›</a>
    <p class="affirm-now" id="affirm-now" aria-live="polite"></p>
    <button type="button" class="affirm-start" id="affirm-play">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
      <span id="affirm-play-label">Start morning session</span>
    </button>
    <p class="affirm-status muted" id="affirm-status"></p>
    <div class="affirm-settings">
      <label>Sprache
        <select id="affirm-lang">{languages.map((l) => <option value={l.id}>{l.label}</option>)}</select>
      </label>
      <label>Stimme
        <select id="affirm-gender"><option value="frau">Frau</option><option value="mann">Mann</option><option value="ich">Meine Aufnahme</option></select>
      </label>
      <label class="affirm-check"><input type="checkbox" id="affirm-music" checked /> Musik</label>
    </div>
  </section>

  <section class="compass-card affirm-mine">
    <p class="eyebrow">Meine Sätze</p>
    <p class="muted">Ein Satz pro Zeile. So werden sie vorgelesen.</p>
    <div data-words="morning">
      <label class="field-label" for="words-morning">Morning</label>
      <textarea class="field" id="words-morning" rows="6" data-field="affirm.morning" data-default={defaultAffirmations.morning}></textarea>
    </div>
    <div data-words="power" hidden>
      <label class="field-label" for="words-power">Power Talk · {'{ziel}'} wird durch dein Money-Ziel ersetzt</label>
      <textarea class="field" id="words-power" rows="8" data-field="affirm.power" data-default={defaultAffirmations.power}></textarea>
    </div>
    <div data-words="evening" hidden>
      <label class="field-label" for="words-evening">Evening</label>
      <textarea class="field" id="words-evening" rows="6" data-field="affirm.evening" data-default={defaultAffirmations.evening}></textarea>
    </div>
  </section>

  <section class="compass-card affirm-rec">
    <p class="eyebrow">Mit meiner Stimme</p>
    <p class="muted">Lies deine Sätze einmal selbst ein, ruhig und mit Pausen. Dann hörst du dich selbst statt der Computerstimme, mit Musik darunter.</p>
    <div class="affirm-rec-actions">
      <button type="button" class="menu-btn" id="rec-btn">● Aufnehmen</button>
      <button type="button" class="menu-btn" id="rec-del" hidden>Aufnahme löschen</button>
    </div>
    <p class="muted affirm-rec-status" id="rec-status" aria-live="polite"></p>
  </section>

  <details class="vision affirm-create" id="affirm-create">
    <summary>Neu erstellen mit Claude</summary>
    <p class="muted">Fragen beantworten, auf „Mit Claude erstellen“ tippen und die neuen Sätze oben bei Meine Sätze einfügen.</p>
    {affirmQuestions.map((q) => (
      <>
        <label class="field-label">{q.label}</label>
        <textarea class="field" rows="2" data-field={q.id}></textarea>
      </>
    ))}
    <a class="menu-btn affirm-claude" id="affirm-claude" href="https://claude.ai/new" target="_blank" rel="noopener">✦ Mit Claude erstellen</a>
  </details>

  <details class="vision affirm-why">
    <summary id="why-title">Warum morgens</summary>
    <div data-why="morning">{science.morning.map((t) => <p>{t}</p>)}</div>
    <div data-why="power" hidden>{science.power.map((t) => <p>{t}</p>)}</div>
    <div data-why="evening" hidden>{science.evening.map((t) => <p>{t}</p>)}</div>
    <p class="muted">{science.tip}</p>
  </details>

  <script>
    import '../../scripts/affirmations';
  </script>
</Base>
