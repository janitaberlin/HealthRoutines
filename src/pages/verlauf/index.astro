---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
---
<Base title="Verlauf" page="verlauf">
  <h1 class="page-title">Verlauf</h1>
  <p class="muted">Die letzten 5 Wochen. Je kräftiger ein Tag, desto mehr war erledigt.</p>

  <section class="reflection compass-card" id="reflection">
    <p class="eyebrow">Plan your week · <span id="reflection-week"></span></p>
    <label class="field-label" for="reflect-plan">Was sind meine Money-Making Activities diese Woche?</label>
    <textarea class="field" id="reflect-plan" rows="3" data-reflect="plan" placeholder="Was bringt diese Woche Umsatz?"></textarea>
    <p class="eyebrow reflection-sub">Wochenreflexion</p>
    <label class="field-label" for="reflect-become">Who did I become this week?</label>
    <textarea class="field" id="reflect-become" rows="3" data-reflect="become" placeholder="Wer bin ich diese Woche geworden?"></textarea>
    <label class="field-label" for="reflect-outcome">What is the outcome?</label>
    <textarea class="field" id="reflect-outcome" rows="3" data-reflect="outcome" placeholder="Was ist aus den Dingen auf meiner To-do-Liste geworden?"></textarea>
    <div id="reflection-past" class="reflection-past" hidden></div>
  </section>

  <a class="answers-link" href={url('antworten/')}>Meine Antworten<span>Alles, was ich in Routinen und Reflexion geschrieben habe ›</span></a>

  <section class="overview" id="overview"></section>

  <h2 class="section-title">Pro Routine</h2>
  <div id="routine-stats" class="routine-stats"></div>

  <h2 class="section-title">Was ich nutze</h2>
  <div id="usage" class="usage"></div>

  <section class="backup">
    <h2 class="section-title">Sicherung</h2>
    <p class="muted">Alles liegt nur auf diesem Handy: Routinen, Antworten, Reflexion, Zyklus, Zeiten, Compass. Einmal im Monat erinnert dich Heute daran, alles als eine Datei in Google Drive zu sichern.</p>
    <div class="backup-actions">
      <button class="menu-btn" type="button" id="export">Jetzt sichern (Drive)</button>
      <label class="menu-btn">
        Sicherung einspielen
        <input type="file" id="import" accept="application/json,.json" hidden />
      </label>
    </div>
    <p id="backup-status" class="muted" aria-live="polite"></p>
  </section>

  <script>
    import '../../scripts/history';
    import '../../scripts/reflection';
  </script>
</Base>
