---
import Base from '../../layouts/Base.astro';
import Spark from '../../components/Spark.astro';
import { becomeHerQuestions, northStarVision, goalStates, identityDefaults, libraryTypes, visionAreas } from '../../data/compass';
---
<Base title="My Inner Compass" page="compass">
  <header class="compass-hero">
    <p class="eyebrow">My Inner Compass</p>
    <h1 class="compass-title">Remember Who You Are</h1>
    <p class="muted">Drei Minuten am Morgen. Nichts muss ausgefüllt werden.</p>
    <button type="button" class="ignite" data-ignite>Ignite my spark ✨</button>
  </header>

  <section class="compass-section" id="north-star">
    <p class="eyebrow">My North Star</p>
    <textarea class="field field-vision" rows="3" data-field="northstar.vision" data-default={northStarVision} aria-label="North-Star-Vision"></textarea>
    <h2 class="compass-h2">Drei Lebensziele</h2>
    <p class="muted">Einmal bewusst festlegen, dann einmal im Monat überprüfen. Morgens wird nichts neu verhandelt.</p>
    {[0, 1, 2].map((i) => (
      <div class="goal" data-goal={i}>
        <textarea class="field" rows="2" data-goal-text placeholder={`Ziel ${i + 1}`}></textarea>
        <div class="goal-states" role="group" aria-label="Status">
          {goalStates.map((s) => (
            <button type="button" class="focus-btn" data-state={s.id} aria-pressed="false" title={s.hint}>{s.label}</button>
          ))}
        </div>
      </div>
    ))}
    <div class="goal-review">
      <p class="muted" id="goal-review-text"></p>
      <button type="button" class="menu-btn" id="goal-review-btn">Ziele überprüft ✓</button>
    </div>
    <p class="compass-reflect" id="goal-reflect" hidden>Passen meine Ziele noch zu mir, oder haben sie sich verändert?</p>
    
  </section>

  <section class="compass-section compass-card">
    <p class="eyebrow">Remember Who You Are</p>
    <textarea class="field field-signature" rows="1" data-field="identity.signature" data-default={identityDefaults.signature}></textarea>
    <label class="field-label">Human Design (Reflexionsrahmen)</label>
    <textarea class="field" rows="2" data-field="identity.design" data-default={identityDefaults.design}></textarea>
    <label class="field-label">Meine Talente</label>
    <textarea class="field" rows="7" data-field="identity.talents" data-default={identityDefaults.talents}></textarea>
    <label class="field-label">Was ich liebe</label>
    <textarea class="field" rows="7" data-field="identity.loves" data-default={identityDefaults.loves}></textarea>
  </section>

  <section class="compass-section">
    <p class="eyebrow">My 10/10 Life</p>
    <h2 class="compass-h2">Don’t just imagine your dream life. Become the person who lives it.</h2>
    {visionAreas.map((a) => (
      <details class="vision">
        <summary>{a.title}</summary>
        <textarea class="field" rows="5" data-field={`vision.${a.id}`} data-default={a.text}></textarea>
      </details>
    ))}
  </section>

  <section class="compass-section">
    <p class="eyebrow">Become Her</p>
    <h2 class="compass-h2">What would the woman I’m becoming do today?</h2>
    <p class="compass-reflect">Wie würde ich heute leben, entscheiden und handeln, wenn ich bereits mein Higher Self wäre?</p>
    <textarea class="field" rows="2" data-field="her.heute" data-default="" aria-label="Higher Self heute"></textarea>
    <details class="vision">
      <summary>Future Self Fragen</summary>
      {becomeHerQuestions.map((q) => (
        <>
          <label class="field-label">{q.q}</label>
          <textarea class="field" rows="2" data-field={`her.${q.id}`} data-default=""></textarea>
        </>
      ))}
    </details>
  </section>

  <section class="compass-section" id="library">
    <p class="eyebrow">My Spark Library</p>
    <h2 class="compass-h2">Was mich zum Leuchten bringt</h2>
    <p class="muted">Musik, Momente, Ideen, Erfolge, Orte, Menschen. Fotos, Videos und Sprachnachrichten als Link (z. B. aus Google Drive oder iCloud).</p>
    <form class="add-form library-form" id="library-form">
      <select id="library-type" aria-label="Art">
        {libraryTypes.map((t) => <option>{t}</option>)}
      </select>
      <input id="library-text" required placeholder="Was ist es?" />
      <input id="library-link" type="url" placeholder="Link (optional)" />
      <button class="menu-btn menu-btn--primary">Hinzufügen</button>
    </form>
    <ul class="library-list" id="library-list"></ul>
  </section>

  <Spark />

  <script>
    import '../../scripts/compass-page';
    import '../../scripts/spark';
  </script>
</Base>
