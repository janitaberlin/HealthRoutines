---
import { url } from '../../lib/url';
// Der Compass ist seit 23.10.2026 Teil von Vision (Identität, My Life, Ziele) und My Journey (Vertiefen).
const target = url('vision/');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>JANITA</title>
  </head>
  <body style="background:#141312;color:#f3eee6;font-family:sans-serif">
    <a href={target} style="color:inherit">Weiter zu Vision</a>
  </body>
</html>
