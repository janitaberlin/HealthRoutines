---
import Base from '../layouts/Base.astro';
import { identity, impulses, principles, routines } from '../data/routines';
import { schedule } from '../data/schedule';
import { CATEGORIES } from '../lib/time';
import { url } from '../lib/url';
import Spark from '../components/Spark.astro';
import { dailyQuestion, northStarVision } from '../data/compass';
---
<Base title="Janita's Health Routines" page="heute">
  <aside class="identity">
    <p class="identity-motto">{identity.motto}</p>
    <p class="identity-sentence" id="identity-sentence">{identity.sentences[0]}</p>
  </aside>

  <button type="button" class="ignite" data-ignite>Ignite my spark ✨</button>
  <p class="today-action" id="today-action" hidden>One inspired action · <strong></strong></p>

  <section class="north-star">
    <div class="north-star-head">
      <p class="eyebrow">My North Star</p>
      <a href={url('compass/#north-star')} class="muted small-link">bearbeiten</a>
    </div>
    <p class="north-star-vision" id="north-star-vision">{northStarVision}</p>
    <ol class="north-star-list" id="north-star-list"></ol>
    <p class="north-star-daily">{dailyQuestion}</p>
    <p class="north-star-review" id="north-star-review" hidden><a href={url('compass/#north-star')}>Zeit für deinen monatlichen Ziel-Check</a></p>
    <p class="muted" id="north-star-empty"><a href={url('compass/#north-star')}>Deine drei wichtigsten Lebensziele festlegen</a></p>
  </section>

  <aside class="impulse">
    <p class="eyebrow">Mindset-Impuls · <span id="impulse-theme">{impulses[0].theme}</span></p>
    <p class="impulse-question" id="impulse-question">{impulses[0].question}</p>
  </aside>

  <section class="now" id="now">
    <p class="eyebrow">Jetzt dran</p>
    <h2 id="now-title">Tagesplan</h2>
    <p id="now-text" class="muted"></p>
    <div class="now-actions" id="now-actions" hidden>
      {CATEGORIES.map((c) => (
        <a class="timer-btn timer-btn--small" data-cat={c.id} href={url(`zeit/?start=${c.id}`)}>▶ {c.label}</a>
      ))}
    </div>
    <details class="plan">
      <summary>Ganzer Tagesplan</summary>
      <ol class="plan-list">
        {schedule.map((b) => (
          <li data-block={b.from}><span>{b.from}–{b.to}</span><strong>{b.title}</strong><small>{b.text}</small></li>
        ))}
      </ol>
    </details>
  </section>

  <section class="day-head">
    <button class="day-nav" type="button" data-shift="-1" aria-label="Vorheriger Tag">‹</button>
    <div class="day-title">
      <p class="eyebrow">Daily Healthy Habits</p>
      <h1 id="day-label">Heute</h1>
      <p id="day-date" class="muted"></p>
    </div>
    <button class="day-nav" type="button" data-shift="1" aria-label="Nächster Tag">›</button>
  </section>

  <div class="day-progress" aria-live="polite">
    <div class="bar"><span id="total-bar"></span></div>
    <p id="total-text" class="muted"></p>
  </div>

  <div class="routines">
    {routines.map((r) => (
      <section class="routine" data-routine={r.id}>
        <header class="routine-head">
          <span class="routine-icon" aria-hidden="true">{r.icon}</span>
          <div class="routine-name">
            <h2>{r.title}</h2>
            {r.subtitle && <p class="routine-sub">{r.subtitle}</p>}
          </div>
          <span class="routine-count" data-count></span>
        </header>
        <ul class="items">
          {r.items.map((item) => (
            <li>
              <button class="item" type="button" data-item={item.id} aria-pressed="false">
                <span class="tick" aria-hidden="true"></span>
                <span class="item-text">
                  {item.text}
                  {item.hint && <small>{item.hint}</small>}
                </span>
              </button>
              {item.note && (
                <textarea class="note" data-note={item.id} rows="1" placeholder="Notiz …" aria-label={item.text}></textarea>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="routine principle">
      <header class="routine-head">
        <span class="routine-icon" aria-hidden="true">{principles.icon}</span>
        <div class="routine-name">
          <h2>{principles.title}</h2>
          <p class="routine-sub">{principles.text}</p>
        </div>
      </header>
      <ul class="principle-list">
        {principles.items.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>

  <Spark />

  <script>
    import '../scripts/today';
    import '../scripts/now';
    import '../scripts/spark';
    import '../scripts/north-star';
  </script>
</Base>
