---
import Base from '../layouts/Base.astro';
import { identity, impulses, principles, routines } from '../data/routines';
import { schedule } from '../data/schedule';
import { CATEGORIES } from '../lib/time';
import { url } from '../lib/url';
import Spark from '../components/Spark.astro';
import { dailyQuestion, identityDefaults, lifeAreas, northStarVision } from '../data/compass';
---
<Base title="JANITA" page="heute">
  <div class="splash" id="splash" aria-hidden="true">
    <p class="splash-eyebrow">Welcome back,</p>
    <p class="splash-name">JANITA</p>
    <p class="splash-text" id="splash-text">{identityDefaults.signature}</p>
  </div>
  <script is:inline>
    // Türöffner: einmal pro App-Start kurz Name und Signatur, Tippen überspringt.
    (() => {
      const el = document.getElementById('splash');
      let seen = false;
      try { seen = sessionStorage.getItem('splash-seen') === '1'; sessionStorage.setItem('splash-seen', '1'); } catch {}
      if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) { el.remove(); return; }
      try {
        const own = JSON.parse(localStorage.getItem('inner-compass') || '{}')?.fields?.['identity.signature']?.trim();
        if (own) document.getElementById('splash-text').textContent = own;
      } catch {}
      const close = () => { el.classList.add('is-leaving'); setTimeout(() => el.remove(), 700); };
      el.addEventListener('click', close);
      setTimeout(close, 2000);
    })();
  </script>
  <section class="welcome">
    <svg class="welcome-wave" viewBox="0 0 200 200" aria-hidden="true">
      <defs><linearGradient id="wave-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c9a26b" stop-opacity="0" /><stop offset="0.55" stop-color="#c9a26b" stop-opacity="0.55" /><stop offset="1" stop-color="#8a6a43" stop-opacity="0" /></linearGradient></defs>
      {Array.from({ length: 28 }, (_, i) => (
        <path d={`M ${20 + i * 2} 0 C ${120 - i * 2} ${40 + i * 2}, ${10 + i * 3} ${120 - i}, ${200} ${150 + i * 1.5}`} fill="none" stroke="url(#wave-gold)" stroke-width="0.4" />
      ))}
    </svg>
    <p class="welcome-hello">Welcome,</p>
    <p class="welcome-name">JANITA.</p>
    <p class="welcome-motto">{identity.motto}</p>
    <p class="identity-sentence" id="identity-sentence">{identity.sentences[0]}</p>
  </section>

  <section class="week-card" aria-label="Diese Woche">
    <div class="week-days" id="week-days">
      {['M', 'D', 'M', 'D', 'F', 'S', 'S'].map((d) => <span>{d}</span>)}
    </div>
    <div class="week-stats">
      <p><span class="label">Day Streak</span><br /><span class="value" id="week-streak">0<small>Tage</small></span></p>
      <p><span class="label">Business · Woche</span><br /><span class="value" id="week-invested">0<small>Std.</small></span></p>
    </div>
  </section>

  <button type="button" class="ritual-card" data-ignite>
    <span class="ritual-text">
      <span class="ritual-title">Remember Who You Are</span>
      <span class="ritual-sub">3 Min. · Remember · Feel · Create</span>
    </span>
    <span class="ritual-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
  </button>
  <p class="today-action" id="today-action" hidden>One inspired action · <strong></strong></p>

  <section class="north-star">
    <div class="north-star-head">
      <p class="eyebrow">My North Star</p>
      <a href={url('compass/#north-star')} class="muted small-link">bearbeiten</a>
    </div>
    <p class="north-star-vision" id="north-star-vision">{northStarVision}</p>
    <ol class="north-star-list" id="north-star-list"></ol>
    <p class="north-star-daily">{dailyQuestion}</p>
    <p class="north-star-review" id="north-star-review" hidden><a href={url('compass/#north-star')}>Zeit für deinen monatlichen Ziel-Check</a></p>
    <p class="muted" id="north-star-empty"><a href={url('compass/#north-star')}>Deine drei wichtigsten Lebensziele festlegen</a></p>
  </section>

  <p class="section-eyebrow">My Life</p>
  <div class="life-cards">
    {lifeAreas.map((a, i) => (
      <a class="life-card" href={url('compass/#my-life')}>
        <img src={url(`vision/${a.id}.jpg`)} alt="" loading="lazy" />
        <div><small>0{i + 1}</small><strong>{a.title}</strong></div>
      </a>
    ))}
  </div>

  <aside class="impulse">
    <p class="eyebrow">Mindset-Impuls · <span id="impulse-theme">{impulses[0].theme}</span></p>
    <p class="impulse-question" id="impulse-question">{impulses[0].question}</p>
  </aside>

  <section class="now" id="now">
    <p class="eyebrow">Jetzt dran</p>
    <h2 id="now-title">Tagesplan</h2>
    <p id="now-text" class="muted"></p>
    <div class="now-actions" id="now-actions" hidden>
      {CATEGORIES.map((c) => (
        <a class="timer-btn timer-btn--small" data-cat={c.id} href={url(`zeit/?start=${c.id}`)}>▶ {c.label}</a>
      ))}
    </div>
    <details class="plan">
      <summary>Ganzer Tagesplan</summary>
      <ol class="plan-list">
        {schedule.map((b) => (
          <li data-block={b.from}><span>{b.from}–{b.to}</span><strong>{b.title}</strong><small>{b.text}</small></li>
        ))}
      </ol>
    </details>
  </section>

  <section class="day-head">
    <button class="day-nav" type="button" data-shift="-1" aria-label="Vorheriger Tag">‹</button>
    <div class="day-title">
      <p class="eyebrow">Daily Healthy Habits</p>
      <h1 id="day-label">Heute</h1>
      <p id="day-date" class="muted"></p>
    </div>
    <button class="day-nav" type="button" data-shift="1" aria-label="Nächster Tag">›</button>
  </section>

  <div class="day-progress" aria-live="polite">
    <div class="bar"><span id="total-bar"></span></div>
    <p id="total-text" class="muted"></p>
  </div>

  <div class="routines">
    {routines.map((r) => (
      <section class="routine" data-routine={r.id}>
        <header class="routine-head">
          <span class="routine-icon" aria-hidden="true">{r.icon}</span>
          <div class="routine-name">
            <h2>{r.title}</h2>
            {r.subtitle && <p class="routine-sub">{r.subtitle}</p>}
          </div>
          <span class="routine-count" data-count></span>
        </header>
        <ul class="items">
          {r.items.map((item) => (
            <li>
              <button class="item" type="button" data-item={item.id} aria-pressed="false">
                <span class="tick" aria-hidden="true"></span>
                <span class="item-text">
                  {item.text}
                  {item.hint && <small>{item.hint}</small>}
                </span>
              </button>
              {item.note && (
                <textarea class="note" data-note={item.id} rows="1" placeholder="Notiz …" aria-label={item.text}></textarea>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="routine principle">
      <header class="routine-head">
        <span class="routine-icon" aria-hidden="true">{principles.icon}</span>
        <div class="routine-name">
          <h2>{principles.title}</h2>
          <p class="routine-sub">{principles.text}</p>
        </div>
      </header>
      <ul class="principle-list">
        {principles.items.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>

  <Spark />

  <script>
    import '../scripts/today';
    import '../scripts/now';
    import '../scripts/spark';
    import '../scripts/north-star';
    import '../scripts/week-card';
  </script>
</Base>
