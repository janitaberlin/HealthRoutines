---
import Base from '../layouts/Base.astro';
import { identity, impulses } from '../data/routines';
import { dailyQuestion } from '../data/compass';
import { schedule } from '../data/schedule';
import { CATEGORIES } from '../lib/time';
import { url } from '../lib/url';
import Spark from '../components/Spark.astro';

const boxes = [
  { id: 'vision', eyebrow: '01 · North Star', title: 'Vision', sub: 'Meine Ziele', href: 'compass/#north-star', img: 'live-enjoy' },
  { id: 'routinen', eyebrow: '02 · Daily Habits', title: 'Routinen', sub: 'Heute abhaken', href: 'routinen/', img: 'body-soul' },
  { id: 'fokus', eyebrow: '03 · Create & Build', title: 'Fokus', sub: 'Stoppuhr starten', href: 'zeit/', img: 'create-build' },
  { id: 'life', eyebrow: '04 · My Life', title: 'My Life', sub: 'Identität & Vision Board', href: 'compass/#my-life', img: 'learn-inspire' },
];
---
<Base title="JANITA" page="heute">
  <div class="splash" id="splash" aria-hidden="true">
    <p class="splash-eyebrow">Welcome back,</p>
    <p class="splash-name">JANITA</p>
    <p class="splash-text">Your energy is your magic.</p>
  </div>
  <script is:inline>
    // Türöffner: einmal pro App-Start kurz Name und „Your energy is your magic.“, Tippen überspringt.
    (() => {
      const el = document.getElementById('splash');
      let seen = false;
      try { seen = sessionStorage.getItem('splash-seen') === '1'; sessionStorage.setItem('splash-seen', '1'); } catch {}
      if (seen || matchMedia('(prefers-reduced-motion: reduce)').matches) { el.remove(); return; }
      const close = () => { el.classList.add('is-leaving'); setTimeout(() => el.remove(), 700); };
      el.addEventListener('click', close);
      setTimeout(close, 2400);
    })();
  </script>
  <section class="welcome">
    <svg class="welcome-wave" viewBox="0 0 200 200" aria-hidden="true">
      <defs>
        <linearGradient id="wave-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f3dc9a" stop-opacity="0" /><stop offset="0.45" stop-color="#e6c25a" stop-opacity="0.85" /><stop offset="0.75" stop-color="#d4a437" stop-opacity="0.65" /><stop offset="1" stop-color="#c9a26b" stop-opacity="0" /></linearGradient>
        <linearGradient id="wave-shine" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0.4" stop-color="#fff7dc" stop-opacity="0" /><stop offset="0.5" stop-color="#fff7dc" stop-opacity="0.95" /><stop offset="0.6" stop-color="#fff7dc" stop-opacity="0" />
          <animateTransform attributeName="gradientTransform" type="translate" values="-1 -1; 1 1" dur="9s" repeatCount="indefinite" />
        </linearGradient>
        <filter id="wave-glow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="0.6" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      </defs>
      <g class="wave-lines">
        {Array.from({ length: 28 }, (_, i) => (
          <path d={`M ${20 + i * 2} 0 C ${120 - i * 2} ${40 + i * 2}, ${10 + i * 3} ${120 - i}, ${200} ${150 + i * 1.5}`} fill="none" stroke="url(#wave-gold)" stroke-width="0.14" />
        ))}
        {/* Glanz, der über die Linien zieht, und feine Glitzerpunkte. */}
        {Array.from({ length: 28 }, (_, i) => (
          <path d={`M ${20 + i * 2} 0 C ${120 - i * 2} ${40 + i * 2}, ${10 + i * 3} ${120 - i}, ${200} ${150 + i * 1.5}`} fill="none" stroke="url(#wave-shine)" stroke-width="0.18" />
        ))}
        {/* Glitzerstern auf der Linie, Versatz, Dauer: bunt gemischt und ab dem Öffnen sichtbar, damit es mal hier, mal da aufblitzt. */}
        {[[63, 29, 0, 11], [71, 51, 6.3, 13], [78, 71, 2.8, 10], [85, 87, 9.1, 12], [95, 102, 4.4, 14], [110, 118, 1.5, 9.5], [132, 135, 7.7, 12.5], [161, 152, 3.6, 11.5]].map(([x, y, d, t]) => (
          <path class="wave-glitter" d={`M ${x} ${y - 4} Q ${x} ${y} ${x + 4} ${y} Q ${x} ${y} ${x} ${y + 4} Q ${x} ${y} ${x - 4} ${y} Q ${x} ${y} ${x} ${y - 4} Z`} style={`animation-delay: -${d}s; animation-duration: ${t}s`} />
        ))}
      </g>
    </svg>
    <p class="welcome-hello">Welcome,</p>
    <p class="welcome-name">JANITA.</p>
    <p class="welcome-motto">{identity.motto}</p>
    <p class="identity-sentence" id="identity-sentence">{identity.sentences[0]}</p>
  </section>



  <section class="week-card" aria-label="Diese Woche">
    <div class="week-days" id="week-days">
      {['M', 'D', 'M', 'D', 'F', 'S', 'S'].map((d) => <span>{d}</span>)}
    </div>
    <div class="week-stats">
      <a href={url('routinen/')}><span class="label">Heute ›</span><br /><span class="value" id="week-streak">0<small>von 0</small></span></a>
      <a href={url('zeit/')}><span class="label">Create ›</span><br /><span class="value" id="week-invested">0<small>Std.</small></span></a>
    </div>
  </section>

  <div class="home-boxes">
    {boxes.map((b) => (
      <a class="home-box" href={url(b.href)}>
        <img src={url(`vision/${b.img}.jpg`)} alt="" loading="lazy" />
        <div><small>{b.eyebrow}</small><strong>{b.title}</strong><span data-box={b.id}>{b.sub}</span></div>
      </a>
    ))}
  </div>

  <section class="north-star">
    <div class="north-star-head">
      <p class="eyebrow">My Goals</p>
      <a href={url('compass/#north-star')} class="muted small-link">Vision ansehen</a>
    </div>
    <ol class="north-star-list" id="north-star-list"></ol>
    <p class="north-star-review" id="north-star-review" hidden><a href={url('compass/#north-star')}>Zeit für deinen monatlichen Ziel-Check</a></p>
    <p class="north-star-daily"><span class="eyebrow">Daily Question</span><br />{dailyQuestion}</p>
  </section>

  <aside class="impulse">
    <p class="eyebrow">Mindset-Impuls · <span id="impulse-theme">{impulses[0].theme}</span></p>
    <p class="impulse-question" id="impulse-question">{impulses[0].question}</p>
  </aside>

  <button type="button" class="ritual-card" data-ignite>
    <span class="ritual-text">
      <span class="ritual-title">Remember Who You Are</span>
      <span class="ritual-sub">3 Min. · Remember · Feel · Create</span>
    </span>
    <span class="ritual-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
  </button>
  <p class="today-action" id="today-action" hidden>One inspired action · <strong></strong></p>


  <section class="now" id="now">
    <p class="eyebrow">Jetzt dran</p>
    <h2 id="now-title">Tagesplan</h2>
    <p id="now-text" class="muted"></p>
    <div class="now-actions" id="now-actions" hidden>
      {CATEGORIES.map((c) => (
        <a class="timer-btn timer-btn--small" data-cat={c.id} href={url(`zeit/?start=${c.id}`)}>▶ {c.label}</a>
      ))}
    </div>
    <details class="plan">
      <summary>Ganzer Tagesplan</summary>
      <ol class="plan-list">
        {schedule.map((b) => (
          <li data-block={b.from}><span>{b.from}–{b.to}</span><strong>{b.title}</strong><small>{b.text}</small></li>
        ))}
      </ol>
    </details>
  </section>

  <Spark />

  <script>
    import '../scripts/now';
    import '../scripts/spark';
    import '../scripts/north-star';
    import '../scripts/week-card';
    import '../scripts/home';
  </script>
</Base>
