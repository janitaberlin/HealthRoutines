---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { levels, goalStates, moneyMindset } from '../../data/compass';
---
<Base title="Money" page="ziele">
  <header class="vision-head">
    <p class="eyebrow">Money &amp; Goals</p>
    <h1 class="page-title">Money</h1>
  </header>

  <section class="compass-card challenge" id="challenge">
    <p class="eyebrow">30-Day Money Challenge</p>
    <p class="challenge-day" id="ch-day"></p>
    <p class="challenge-task" id="ch-task"></p>
    <button type="button" class="affirm-start" id="ch-done" hidden>✓ Challenge erledigt</button>
    <label class="money-reached challenge-earned" id="ch-earned-box" hidden>Heute verdient <input id="ch-earned" inputmode="decimal" placeholder="0 €" /></label>

    <div class="challenge-goal">
      <div id="ch-goal-open">
        <label class="field-label" for="ch-goal">Mein Ziel für die 30 Tage</label>
        <input class="money-input" id="ch-goal" placeholder="z. B. 3000 €" inputmode="decimal" />
        <button type="button" class="menu-btn" id="ch-lock">Ziel festlegen</button>
      </div>
      <div id="ch-goal-locked" hidden>
        <p class="challenge-sum"><span id="ch-total"></span> <span class="muted">von <span id="ch-goal-show"></span></span><button type="button" class="money-unlock" id="ch-unlock" aria-label="Ziel ändern">🔒</button></p>
        <div class="money-bar"><span id="ch-bar"></span></div>
      </div>
    </div>

    <div class="challenge-grid" id="ch-grid" aria-label="30 Tage"></div>
    <p class="muted challenge-hint" id="ch-hint"></p>
  </section>

  <section class="compass-card money-card" id="money">
    <div class="money-weeks" role="group" aria-label="Woche">
      <button type="button" class="focus-btn" data-money-week="0">Diese Woche</button>
      <button type="button" class="focus-btn" data-money-week="1">Nächste Woche</button>
    </div>
    <p class="eyebrow">Money-Ziel · <span id="money-week-label"></span></p>
    <div id="money-open">
      <input class="money-input" id="money-goal" placeholder="1000 €" inputmode="decimal" aria-label="Mein Money-Ziel" />
      <button type="button" class="affirm-start money-lock" id="money-lock">Ziel festlegen</button>
    </div>
    <div id="money-locked" hidden>
      <p class="money-amount"><span id="money-goal-show"></span><button type="button" class="money-unlock" id="money-unlock" aria-label="Ziel ändern">🔒</button></p>
      <div class="money-bar"><span id="money-bar"></span></div>
      <div class="money-reached">
        <label>Erreicht <input id="money-reached" inputmode="decimal" placeholder="0 €" /></label>
        <button type="button" class="focus-btn" id="money-done" aria-pressed="false">✓ Geschafft</button>
      </div>
      <p class="muted money-note" id="money-note"></p>
    </div>
    <p class="muted">Ich darf total kreativ sein, wie ich es erreiche, und Spaß dabei haben.</p>
    <details class="money-past" id="money-past" hidden>
      <summary>Frühere Wochen</summary>
      <ul id="money-past-list"></ul>
    </details>
  </section>

  <section class="compass-card money-card" id="plan">
    <p class="eyebrow">Plan your week · <span data-week-label></span></p>
    <label class="field-label" for="reflect-plan">Was sind meine Money-Making Activities diese Woche?</label>
    <textarea class="field" id="reflect-plan" rows="4" data-reflect="plan" placeholder="Was bringt diese Woche Umsatz?"></textarea>
  </section>

  <section class="compass-section" id="north-star">
    <p class="eyebrow">Plan your year</p>
    <h2 class="compass-h2">My next 3 big goals</h2>
    <p class="muted">Einmal bewusst festlegen, dann einmal im Monat überprüfen. Morgens wird nichts neu verhandelt.</p>
    {[0, 1, 2].map((i) => (
      <div class="goal" data-goal={i}>
        <textarea class="field" rows="2" data-goal-text placeholder={`Big Goal ${i + 1}`}></textarea>
        <div class="goal-states" role="group" aria-label="Status">
          {goalStates.map((s) => (
            <button type="button" class="focus-btn" data-state={s.id} aria-pressed="false" title={s.hint}>{s.label}</button>
          ))}
        </div>
      </div>
    ))}
    <div class="goal-review">
      <p class="muted" id="goal-review-text"></p>
      <button type="button" class="menu-btn" id="goal-review-btn">Ziele überprüft ✓</button>
    </div>
    <p class="compass-reflect" id="goal-reflect" hidden>Passen meine Ziele noch zu mir, oder haben sie sich verändert?</p>
    <details class="vision">
      <summary>Mein Why, What und How</summary>
      <div class="levels">
        {levels.map((l) => (
          <div class="level">
            <p class="level-label">{l.label} <span>· {l.hint}</span></p>
            <textarea class="field" rows="2" data-field={`level.${l.id}`} data-default={l.text}></textarea>
          </div>
        ))}
      </div>
    </details>
  </section>

  <section class="compass-card money-card">
    <p class="eyebrow">Mein Money-Mindset</p>
    <textarea class="field" rows="6" data-field="money.mindset" data-default={moneyMindset} aria-label="Mein Money-Mindset"></textarea>
    <a class="affirm-start money-power" href={url('affirmationen/?mode=power')}>▶ Power Talk anhören</a>
  </section>

  <script>
    import '../../scripts/challenge';
    import '../../scripts/money-goal';
    import '../../scripts/compass-page';
    import '../../scripts/reflection';
  </script>
</Base>
