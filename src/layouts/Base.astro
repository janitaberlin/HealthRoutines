---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  page: 'heute' | 'compass' | 'zeit' | 'verlauf';
}
const { title, page } = Astro.props;
const appName = "Janita's Health Routines";
const pageTitle = title === appName ? title : `${title} · ${appName}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="Meine täglichen Routinen zum Abhaken" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Routinen" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Parameter vom Aktualisieren-Knopf wieder aus der Adresse entfernen.
      try {
        const u = new URL(location.href);
        if (u.searchParams.has('neu')) {
          u.searchParams.delete('neu');
          history.replaceState(history.state, '', u.pathname + u.search + u.hash);
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={url('')} aria-label={`Startseite: ${appName}`}>
        <svg class="home-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8 12.5 2.8 2.8L16.5 9.5" /></svg>
        <span>{appName}</span>
      </a>
      <div class="header-actions">
        <button class="refresh-btn" type="button" aria-label="Aktualisieren" title="Aktualisieren">↻</button>
        <button class="theme-toggle" type="button" aria-label="Dunkles Design" aria-pressed="false">◐</button>
      </div>
    </header>
    <nav class="book-switch" aria-label="Ansicht">
      <a class="book-btn" href={url('')} aria-current={page === 'heute' ? 'page' : undefined}>Heute</a>
      <a class="book-btn" href={url('compass/')} aria-current={page === 'compass' ? 'page' : undefined}>Compass</a>
      <a class="book-btn" href={url('zeit/')} aria-current={page === 'zeit' ? 'page' : undefined}>Zeit</a>
      <a class="book-btn" href={url('verlauf/')} aria-current={page === 'verlauf' ? 'page' : undefined}>Verlauf</a>
    </nav>
    <main class="page">
      <slot />
    </main>
    <script>
      import '../scripts/theme';
      import '../scripts/refresh';
    </script>
  </body>
</html>
