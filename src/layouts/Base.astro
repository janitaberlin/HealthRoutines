---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  page: 'heute' | 'routinen' | 'compass' | 'zeit' | 'verlauf' | 'zyklus' | 'antworten';
}
const { title, page } = Astro.props;
const appName = 'JANITA';
const tabs = [
  { id: 'heute', href: '', label: 'Heute', icon: '<path d="M4 11 12 4l8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>' },
  { id: 'routinen', href: 'routinen/', label: 'Routinen', icon: '<circle cx="12" cy="12" r="8.5"/><path d="m8.5 12.3 2.4 2.4 4.6-5"/>' },
  { id: 'compass', href: 'compass/', label: 'Compass', icon: '<circle cx="12" cy="12" r="8.5"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>' },
  { id: 'zeit', href: 'zeit/', label: 'Zeit', icon: '<circle cx="12" cy="13" r="7.5"/><path d="M12 9v4l2.5 2M10 3h4"/>' },
  { id: 'verlauf', href: 'verlauf/', label: 'Verlauf', icon: '<path d="M5 20V10M12 20V4M19 20v-7"/>' },
];
const pageTitle = title === appName ? title : `${title} · ${appName}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="Meine täglichen Routinen zum Abhaken" />
    <meta name="theme-color" content="#141312" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500&display=swap" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="JANITA" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      // Parameter vom Aktualisieren-Knopf wieder aus der Adresse entfernen.
      try {
        const u = new URL(location.href);
        if (u.searchParams.has('neu')) {
          u.searchParams.delete('neu');
          history.replaceState(history.state, '', u.pathname + u.search + u.hash);
        }
      } catch {}
    </script>
  </head>
  <body data-page={page}>
    <header class="site-header">
      <a class="site-title" href={url('')} aria-label={`Startseite: ${appName}`}>
        <span>DREAM BIG</span>
      </a>
      <div class="header-actions">
        <button class="refresh-btn" type="button" aria-label="Aktualisieren" title="Aktualisieren">↻</button>
        <button class="theme-toggle" type="button" aria-label="Dunkles Design" aria-pressed="false">◐</button>
      </div>
    </header>
    <main class="page">
      <slot />
    </main>
    <nav class="tabbar" aria-label="Navigation">
      {tabs.map((t) => (
        <a class="tab" href={url(t.href)} aria-current={page === t.id ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
          <span>{t.label}</span>
        </a>
      ))}
    </nav>

    <script>
      import '../scripts/theme';
      import '../scripts/refresh';
      import { trackUse } from '../scripts/storage';
      trackUse(document.body.dataset.page ?? '');
    </script>
  </body>
</html>
